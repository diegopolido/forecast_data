<h1>Weather Forecast</h1>

<% if @forecast %>
  <div class="current-weather">
    <h2>Current Weather</h2>
    <table class="table">
      <thead>
        <tr>
          <th>Temperature</th>
          <th>High</th>
          <th>Low</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= @forecast[:current_weather][:temperature] %>°C</td>
          <td><%= @forecast[:current_weather][:high] %>°C</td>
          <td><%= @forecast[:current_weather][:low] %>°C</td>
          <td><%= @forecast[:current_weather][:description] %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <hr>

  <div class="forecast-table">
    <h2>5-Day Forecast</h2>
    <table class="table">
      <thead>
        <tr>
          <th>Date and Time</th>
          <th>Temperature</th>
          <th>High</th>
          <th>Low</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <% @forecast[:forecast].each do |day| %>
          <tr>
            <td><%= day[:datetime] %></td>
            <td><%= day[:temperature] %>°C</td>
            <td><%= day[:high] %>°C</td>
            <td><%= day[:low] %>°C</td>
            <td><%= day[:description] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="forecast-chart">
    <h2>Temperature Chart</h2>
    <canvas id="forecastChart"></canvas>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const ctx = document.getElementById('forecastChart').getContext('2d');
      const labels = [<%= raw @forecast[:forecast].map { |day| "'#{day[:datetime]}'" }.join(', ') %>];
      const temperatures = [<%= @forecast[:forecast].map { |day| day[:temperature] }.join(', ') %>];

      new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            label: 'Temperature (°C)',
            data: temperatures,
            borderColor: 'rgba(75, 192, 192, 1)',
            backgroundColor: 'rgba(75, 192, 192, 0.2)',
            borderWidth: 1
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: {
              position: 'top',
            },
          },
          scales: {
            x: {
              title: {
                display: true,
                text: 'Date and Time'
              }
            },
            y: {
              title: {
                display: true,
                text: 'Temperature (°C)'
              }
            }
          }
        }
      });
    });
  </script>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    .table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
    }

    .table th, .table td {
      border: 1px solid #ddd;
      padding: 8px;
      text-align: center;
    }

    .table th {
      background-color: #f2f2f2;
      font-weight: bold;
    }

    .forecast-chart {
      margin-top: 30px;
    }
  </style>
<% else %>
  <p>No forecast available.</p>
<% end %>